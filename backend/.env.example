# Node Server Environment
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Prisma format)
# e.g., postgresql://username:password@localhost:5432/tx_browser_notifications?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tx_notifications?schema=public

# Firebase Admin SDK Credentials (FCM HTTP v1)
FIREBASE_PROJECT_ID=tx-browser
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tx-browser.iam.gserviceaccount.com
# For multiline private key in .env, wrap in quotes with literal \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Admin Authentication & Sessions
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=super_secret_cookie_session_key_min_32_chars_long_12345

# Allowed CORS Origins (comma-separated or *)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,https://notify.txbrowser.com

# Admin Seeding (Used by npm run seed:admin)
SEED_ADMIN_EMAIL=admin@txbrowser.com
SEED_ADMIN_PASSWORD=ChangeMeNowSecure123!
SEED_ADMIN_NAME=TX Super Admin
